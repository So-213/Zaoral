{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "middleware.ts": {
      "runtime": "nodejs"
    },
    "app/dashboard/**/*.tsx": {
      "runtime": "nodejs"
    },
    "app/create/**/*.tsx": {
      "runtime": "nodejs"
    },
    "app/account/**/*.tsx": {
      "runtime": "nodejs"
    }
  }
}
